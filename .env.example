# Names only. Values live in .env.local (ignored) and in Vercel env.

# Site
NEXT_PUBLIC_SITE_URL=

# Supabase (required for the shop)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Auth / order links / email
ORDER_LINK_SECRET=
RESEND_API_KEY=
CONTACT_TO=

# Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Local only — skip Turnstile remote verify when set to 1
NEXT_PUBLIC_USE_EMULATORS=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Card payments (off until Step 0)
BANK_MERCHANT_ID=
BANK_SECRET_KEY=
BANK_ENDPOINT=
BANK_PORTAL_URL=

# Legacy Firebase (emulator tests only — not used by the shop runtime)
GCLOUD_PROJECT=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_STORAGE_ORIGIN=
