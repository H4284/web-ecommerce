{
  "name": "sanem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "emulators": "firebase emulators:start --project demo-sanem --import=.emulator-data --export-on-exit",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "run:local": "tsx --conditions=react-server --env-file-if-exists=.env.local",
    "run:remote": "tsx --conditions=react-server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-sanem \"vitest run tests/rules\"",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-sanem \"vitest run --passWithNoTests tests/emulator\"",
    "e2e": "playwright test",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage --project demo-sanem \"node scripts/e2e-ci.mjs\"",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "^15.31.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
